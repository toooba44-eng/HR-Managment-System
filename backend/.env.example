PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
DATABASE_PATH=./database/hr_system.db
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Force seeding demo data even in production (idempotent — skips if already seeded)
SEED_DB=false
