# ---- docker-compose overrides (all optional) ----

# Host port to expose the frontend on (default 8080)
FRONTEND_PORT=8080

# Secret used to sign JWTs — CHANGE THIS in production
JWT_SECRET=quant_hr_super_secret_key_2026_change_in_production

# Allowed CORS origin for the backend API
CORS_ORIGIN=http://localhost:8080

# Seed demo data on first boot (idempotent)
SEED_DB=true
